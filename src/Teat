5. JavaScript Logic

:::writing{variant=“standard” id=“hub_final_js”}

let applications=[]
let roster=[]

async function loadData(){

applications = await fetch("data/applications.json").then(r=>r.json())
roster = await fetch("data/roster.json").then(r=>r.json())

renderApps(applications)
renderRoster()

}

function renderApps(data){

let itarTable=document.getElementById("itarTable")
let nonTable=document.getElementById("nonItarTable")

itarTable.innerHTML=itarTable.rows[0].outerHTML
nonTable.innerHTML=nonTable.rows[0].outerHTML

data.forEach(app=>{

let row=`<tr>
<td>${app.application}</td>
<td>${app.technology}</td>
<td>${app.sme}</td>
<td>${app.criticality}</td>
<td><a href="${app.aud}" target="_blank">Open</a></td>
</tr>`

if(app.type==="ITAR"){
itarTable.innerHTML+=row
}else{
nonTable.innerHTML+=row
}

})

}

function renderRoster(){

let panel=document.getElementById("rosterPanel")

roster.forEach(r=>{
panel.innerHTML+=`<div class="rosterCard">
<b>${r.name}</b><br>
Shift: ${r.shift}
</div>`
})

}

document.getElementById("searchBox").addEventListener("keyup",function(){

let text=this.value.toLowerCase()

let filtered=applications.filter(a =>
a.application.toLowerCase().includes(text) ||
a.sme.toLowerCase().includes(text) ||
a.technology.toLowerCase().includes(text)
)

renderApps(filtered)

})

loadData()

:::

