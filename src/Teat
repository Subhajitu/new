6. Python Script (Excel → JSON)

:::writing{variant=“standard” id=“hub_final_py”}

import pandas as pd
import json

apps=pd.read_excel("excel/master_apps.xlsx")
links=pd.read_excel("excel/links.xlsx")

data=apps.merge(links,on="Application Name")

applications=[]

for _,r in data.iterrows():

applications.append({

"application":r["Application Name"],
"type":r["ITAR / Non-ITAR"],
"technology":r["Technology"],
"sme":r["Primary spdemo SME"],
"criticality":r["Business Criticality"],
"aud":r["AUD"]

})

with open("data/applications.json","w") as f:
json.dump(applications,f)

roster=pd.read_excel("excel/roster.xlsx")

rosterData=[]

for _,r in roster.iterrows():

rosterData.append({
"name":r["Name"],
"shift":r["Shift"]
})

with open("data/roster.json","w") as f:
json.dump(rosterData,f)

print("Data generated")

:::

